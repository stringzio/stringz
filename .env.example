# ── Frontend ──────────────────────────────────────────────
# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Vite inlines this into the browser bundle - it is NOT a secret, but use your
# own id so usage is attributed to you.
VITE_WC_PROJECT_ID=

# ── Backend (server/) ─────────────────────────────────────
# Bun auto-loads this file when the server runs from the repo root.
SERVER_PORT=8787
# SQLite file (default: server/data/flowkit.db). For Postgres, set DATABASE_URL.
DATABASE_PATH=
# Public origin of the web app - used to build OAuth callback URLs.
PUBLIC_APP_URL=http://localhost:3000

# OAuth (optional - leave empty to keep those providers disabled/"SOON").
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Billing (Phase 3c) - set BILLING_PROVIDER to enable checkout/webhooks
# BILLING_PROVIDER=x402 # or "commerce"
# X402_FACILITATOR_URL=
# X402_API_KEY=
# X402_WEBHOOK_SECRET=
# COMMERCE_API_KEY=
# COMMERCE_WEBHOOK_SECRET=
# PUBLIC_APP_URL=
