# Stringz environment. Bun auto-loads this file when running from the repo
# root (bun run server / bun run dev:all) - copy to .env and fill in.
# Everything here is optional to START except DATABASE_URL; features stay
# disabled (and say so in the UI) until their variables are set.

# ── Frontend ──────────────────────────────────────────────
# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Vite inlines this into the browser bundle - it is NOT a secret, but use
# your own id so usage is attributed to you.
VITE_WC_PROJECT_ID=

# ── Backend core ──────────────────────────────────────────
SERVER_PORT=8787
# Required. Local dev: docker compose -f compose.yaml up -d postgres
DATABASE_URL=postgres://flowkit:flowkit@127.0.0.1:5432/flowkit
# Set to "require" only for connections over a public IP (e.g. Cloud SQL).
DATABASE_SSL=

# Public origin of the web app - builds OAuth callback URLs.
PUBLIC_APP_URL=http://localhost:3000

# ── Auth providers (all optional) ─────────────────────────
# A provider stays "coming soon" in the UI until its pair is set.
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Operator admin dashboard (optional) ───────────────────
# Leave empty to disable /admin entirely.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── stringz-pay payment rail (optional) ───────────────────
# Our hosted stablecoin checkout. Without it the app runs in community
# mode: entitlements fall back to local plan columns and checkout answers
# with a clear error instead of charging (see README, Self-hosting).
STRINGZ_PAY_URL=
STRINGZ_PAY_API_KEY=

# ── Cloud simulation fleet (optional, GCP) ────────────────
# Powers the canvas Simulate button. Without these the builder still
# compiles and exports; simulations run locally via the exported project.
GCP_PROJECT_ID=
SIM_BUCKET=
SIM_QUEUE=
SIM_QUEUE_LOCATION=us-central1
SIM_JOB_NAME=sim-runner
SIM_JOB_LOCATION=us-central1
SIM_DISPATCH_SA_EMAIL=
# Shared secret for the runner ingest callback. Empty generates a random
# one per boot (fine for a single instance; set it when running several).
SIM_INGEST_SECRET=
